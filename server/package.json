{
  "name": "hcfmailer-plus-server",
  "private": true,
  "version": "1.0.0",
  "description": "Self hosted email newsletter app - server",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "lint": "eslint . --ext .js",
    "dev:init-password": "node setup/docker-entrypoint-db-setup.js \"${ADMIN_PASSWORD:-test}\" \"${ADMIN_TOKEN:-}\"",
    "sqlinit": "node setup/sql/init.js",
    "sqldump": "node setup/sql/dump.js | sed -e '/^\\/\\*.*\\*\\/;$/d' -e 's/.[0-9]\\{4\\}-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9]./NOW()/g' > setup/sql/mailtrain${DUMP_NAME_SUFFIX}.sql",
    "sqldrop": "node setup/sql/drop.js",
    "sqlgen": "bun run sqldrop && DB_FROM_START=Y bun run sqlinit && bun run sqldump",
    "sqldumptest": "NODE_ENV=test DUMP_NAME_SUFFIX=-test bun run sqldump",
    "sqlresettest": "NODE_ENV=test bun run sqldrop && NODE_ENV=test bun run sqlinit",
    "starttest": "NODE_ENV=test node index.js",
    "_e2e": "NODE_ENV=test node test/e2e/index.js",
    "e2e": "bun run sqlresettest && bun run _e2e"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/highcanfly-club/hcfmailer-plus.git"
  },
  "license": "GPL-3.0",
  "homepage": "https://highcanfly.club/",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "http-proxy-middleware": "^4.2.1",
    "lodash": "^4.18.1",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "url-pattern": "^1.0.3"
  },
  "optionalDependencies": {
    "posix": "^4.2.0"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1156.0",
    "@faker-js/faker": "^10.6.0",
    "bcryptjs": "^3.0.3",
    "bluebird": "^3.7.2",
    "body-parser": "^2.4.0",
    "bounce-handler": "7.3.2-fork.3",
    "capitalize": "^2.0.4",
    "compression": "^1.8.2",
    "config": "^5.0.1",
    "connect-flash": "^0.1.1",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",

    "csurf": "^1.11.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "device": "^0.3.12",
    "escape-html": "^1.0.3",
    "escape-string-regexp": "^5.0.0",
    "express": "^5.3.0",
    "express-locale": "^2.0.2",
    "express-session": "^1.19.0",
    "feedparser-promised": "^2.0.1",
    "fs-extra": "^11.4.1",
    "fs-extra-promise": "^1.0.1",
    "geoip-ultralight": "^0.1.5",
    "gm": "^1.25.1",
    "handlebars": "^4.7.10",
    "hbs": "^4.4.0",
    "he": "^2.0.0",
    "html-to-text": "^10.0.1",
    "humanize": "0.0.9",
    "i18next": "^26.5.11",
