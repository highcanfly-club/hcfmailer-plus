    "mjml": "^5.4.1",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.5",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.2",
    "node-ipc": "^12.0.0",
    "node-mocks-http": "^1.18.1",
    "node-object-hash": "^3.1.1",
    "nodeify": "^1.0.1",
    "nodemailer": "^10.2.1",
    "nodemailer-openpgp": "^2.2.1",
    "npmlog": "^7.0.1",
    "openpgp": "^6.3.2",
