<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <meta name="description" content="Self hosted email newsletter app">
    <link rel="shortcut icon" href="{{publicPath}}static/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="{{publicPath}}static/favicon.ico">

    <title>HCFMailer+</title>

    <script src="{{publicPath}}static-npm/jquery.min.js"></script>

    {{#if mailtrainConfig}}
        <script>
            {{#if reactCsrfToken}}window.csrfToken = '{{reactCsrfToken}}';{{/if}}
            window.mailtrainConfig = {{{mailtrainConfig}}};
        </script>

        {{#if isDev}}
        <script type="module">
            import RefreshRuntime from '{{publicPath}}client/@react-refresh';
            RefreshRuntime.injectIntoGlobalHook(window);
            window.$RefreshReg$ = () => {};
            window.$RefreshSig$ = () => () => {};
            window.__vite_plugin_react_preamble_installed__ = true;
        </script>
        {{/if}}

        {{#each scriptFiles}}
            {{#if this.type}}
                <script type="{{this.type}}" src="{{this.src}}"></script>
            {{else}}
                <script src="{{this}}"></script>
            {{/if}}
        {{/each}}
    {{/if}}
</head>

<body class="grapesjs-body">
{{{body}}}
</body>

</html>
