{
  "name": "hcfmailer-plus",
  "version": "2.0.0",
  "description": "Self-hosted email newsletter application based on Mailtrain",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared",
    "zone-mta"
  ],
  "scripts": {
    "dev": "concurrently -n infra,client,server -c cyan,green,yellow \"npm run dev:infra\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:infra": "docker compose -f docker-compose-develop.yml up",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:zone-mta": "npm run start --workspace=zone-mta",
    "build": "npm run build --workspace=client",
    "build:all": "npm run build --workspaces",
    "install:all": "npm install --workspaces --include-workspace-root"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
