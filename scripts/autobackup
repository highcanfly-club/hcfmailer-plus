set -o pipefail

source "$(dirname "$0")/backup-common.sh"

MYSQL_SSL_VERIFY_SERVER_CERT=${MYSQL_SSL_VERIFY_SERVER_CERT:-'FALSE'}

if [ -z "$BACKUP_TO" ] || [ -z "$BACKUP_FROM" ]; then
  echo "BACKUP_TO and BACKUP_FROM must be set"
  exit 1
fi

require_command /usr/bin/mariadb-dump || exit 1
require_command /usr/bin/openssl || exit 1
require_command /usr/sbin/sendmail || exit 1

load_mail_credentials

MAILUSER=${MAILUSER:-}
MAILPASSWD=${MAILPASSWD:-}

if [ -z "$MAILUSER" ] || [ -z "$MAILPASSWD" ]; then
  echo "MAILUSER and MAILPASSWD must be configured in /app/zone-mta/config/builtin-zonemta.json"
  exit 1
fi

NOW=$(date -I)
LOCAL_DUMP="/app/server/files/backup.sql"
BACKUP_ARCHIVE="/app/server/files/backup.tar.xz"

/usr/bin/mariadb-dump --ssl-verify-server-cert=$MYSQL_SSL_VERIFY_SERVER_CERT -h "$MYSQL_HOST" --password="$MYSQL_ROOT_PASSWORD" --all-databases > "$LOCAL_DUMP"
DUMP_RC=$?
if ! check_mariadb_dump "$LOCAL_DUMP" "$DUMP_RC"; then
  send_admin_error "Backup dump validation failed" "The database dump failed or produced invalid output for ${LOCAL_DUMP}."
  exit 1
fi

SQL_SIZE_BYTES=$(stat -c%s "$LOCAL_DUMP" 2>/dev/null || wc -c < "$LOCAL_DUMP" | tr -d ' ')

if ! tar -cv "$LOCAL_DUMP" /app/server/files/campaign /app/server/files/certs /app/server/files/imports /app/server/files/reports /app/server/files/template /app/server/files/uploaded | xz -9 > "$BACKUP_ARCHIVE"; then
  send_admin_error "Backup archive failed" "Failed to create archive ${BACKUP_ARCHIVE}."
  exit 1
fi
BACKUP_ARCHIVE_KB=$(du -k "$BACKUP_ARCHIVE" 2>/dev/null | awk '{print $1}')
BACKUP_ARCHIVE_KB_FR=$(format_number_fr "$BACKUP_ARCHIVE_KB")
SQL_SIZE_BYTES_FR=$(format_number_fr "$SQL_SIZE_BYTES")

rm -f "$LOCAL_DUMP"

split -b 10m "$BACKUP_ARCHIVE" /tmp/backup.$NOW.tar.xz.
TOTAL=$(ls /tmp/backup.$NOW.tar.xz.* 2>/dev/null | wc -l | tr -d ' ')
SPLIT_FILES=""
for SPLIT_FILE in /tmp/backup.$NOW.tar.xz.*; do
  if [ -f "$SPLIT_FILE" ]; then
    SPLIT_FILES="${SPLIT_FILES}$(basename "$SPLIT_FILE")"$'\n'
  fi
done

COUNT=0
for FILE in /tmp/backup.$NOW.tar.xz.*; do
  if [ ! -f "$FILE" ]; then
    continue
  fi
  COUNT=$((COUNT+1))
  send_backup_email "$NOW" "$COUNT" "$TOTAL" "$FILE" "$BACKUP_FROM" "$BACKUP_TO" "$MAILUSER" "$MAILPASSWD" '127.0.0.1:2525' "$SPLIT_FILES" "$BACKUP_ARCHIVE_KB_FR" "$SQL_SIZE_BYTES_FR"
  rm -f "$FILE"
done
